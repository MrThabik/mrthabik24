{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=()"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000; includeSubDomains"
    },
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://formspree.io https://api.web3forms.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/private/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/sitemap.xml",
   "destination": "/api/sitemap"
  },
  {
   "source": "/robots.txt",
   "destination": "/api/robots"
  },
  {
   "source": "/(project|resume|originals|esim|intern|experience|education|academic|internship|skills|certificates|projectphotos|calculator|hire|contact)",
   "destination": "/index.html"
  }
 ]
}